# .env.local로 복사한 뒤 로컬 값 설정. 실제 값 커밋 금지.
DB_URL=jdbc:postgresql://127.0.0.1:55432/waterleague
DB_USER=waterleague
DB_PASSWORD=
DATABASE_URL=postgresql://waterleague:CHANGE_ME@127.0.0.1:55432/waterleague
KMA_API_KEY=
# 브이월드 공개 공간자료 추가 조회용; 실제 값은 .env.local만 사용
VWORLD_API_KEY=
# 인증키 관리 화면에 등록한 서비스 URL과 정확히 일치
VWORLD_DOMAIN=http://127.0.0.1:5173
# 기관 계정 승인 시 설정: 32바이트 난수의 Base64 인코딩, DB와 별도 보관
MFA_ENCRYPTION_KEY=
# 필요 시 기본 경로 변경
# SWMM_LIBRARY=/absolute/path/to/libswmm5.dylib
# ARTIFACTS_PATH=/absolute/path/to/data/runs
