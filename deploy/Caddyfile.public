{
    admin off
    http_port 8080
    https_port 8443
}
{$WATERLEAGUE_DOMAIN} {
    import Caddyfile.common
}
www.{$WATERLEAGUE_DOMAIN} {
    header {
        -Server
        Strict-Transport-Security "max-age=31536000"
    }
    redir https://{$WATERLEAGUE_DOMAIN}{uri} 308
}
http://127.0.0.1:8081 {
    respond /healthz 200
}
